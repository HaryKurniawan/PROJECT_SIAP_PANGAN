#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Path to the commit message file
msg_file=$1
# Read the first line of the commit message
msg=$(head -n1 "$msg_file")

# Regex to validate standard commit format
# feat, fix, docs, chore (optionally with scope)
regex="^(feat|fix|docs|chore)(\([a-zA-Z0-9_\-]+\))?: .+"

if [[ ! $msg =~ $regex ]]; then
  echo "\n🚨 Error: Format pesan commit tidak valid!"
  echo "Format yang benar: <type>(<scope>): <subject>"
  echo "Tipe yang diizinkan: feat, fix, docs, chore"
  echo "Contoh: feat(ui): tambah tombol login"
  echo "\nGunakan 'npm run commit' untuk commit interaktif."
  exit 1
fi
